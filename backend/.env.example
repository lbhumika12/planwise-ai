# PlanWise AI - Environment Configuration Example
# Copy this file to .env and fill in your values

# AI Provider Configuration (optional - app works without these)
# Uncomment and set the one you want to use:

# OpenAI
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Anthropic Claude
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
# AI_PROVIDER=gemini
# GEMINI_API_KEY=AIza...

# Application Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# Database
DATABASE_URL=sqlite:///./planwise.db

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Default User Settings
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_START_TIME=09:00
DEFAULT_END_TIME=21:00
DEFAULT_BREAK_DURATION=30
