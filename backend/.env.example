# PlanWise AI - Environment Configuration Example
# Copy this file to .env and fill in your values

# AI Provider Configuration (optional - app works with rule-based fallback without these)
# Uncomment and set the one you want to use:

# Google Gemini
# AI_PROVIDER=gemini
# GEMINI_API_KEY=AIza...

# OpenAI
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Anthropic Claude
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Application Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# Database Configuration
# Local Development (SQLite):
DATABASE_URL=sqlite:///./planwise.db

# Production on Render / Supabase / Neon (PostgreSQL):
# Render Managed Postgres provides an Internal or External Database URL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS Origins (comma-separated; *.vercel.app is automatically allowed in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# Default User Settings
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_START_TIME=09:00
DEFAULT_END_TIME=21:00
DEFAULT_BREAK_DURATION=30
